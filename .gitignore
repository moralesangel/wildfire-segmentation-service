# Data: FLAME is 5 GB and carries its own licence. Fetch it yourself.
data/
*.zip

# The PyTorch checkpoint is a build artifact of training.
models/*.pt
models/*.pth

# The exported ONNX is not: at 7.8 MB it ships with the repo, so a clone
# serves the real model rather than the stub. Without it every visitor would
# measure a placeholder and see placeholder masks.
!models/*.onnx

__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/

.pytest_cache/
.mypy_cache/
.ruff_cache/

.env
.DS_Store
Thumbs.db
.vscode/
.idea/
